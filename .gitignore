# Raw GOSA source downloads (~1.6GB) — kept local only.
# Compiled databases (georgia_comprehensive_db.json, georgia_schools_master.json,
# gosa_multiyear_database.json), manifest.json, and latest_update_report.json
# still get tracked since they're small and are what the weekly checker updates.
server/data/gosa/**/*.csv
server/data/gosa/**/*.xls
server/data/gosa/**/*.xlsx
